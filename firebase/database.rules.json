{
  "rules": {
    ".read": false,
    ".write": false,

    "master": {
      "config": {
        ".read": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'",
        ".write": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'"
      },
      "ui": {
        ".read": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'",
        ".write": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'"
      }
    },

    "indexes": {
      "siglas": {
        ".read": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'",
        "$sigla": {
          ".write": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'"
        }
      }
    },

    "stores": {
      ".read": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'",
      "$sigla": {
        ".read": "auth != null && (auth.token.email == 'master@regionalaltaperformance.firebaseapp.com' || auth.token.email == ('loja.' + $sigla.toLowerCase() + '@regionalaltaperformance.firebaseapp.com'))",
        ".write": "auth != null && auth.token.email == 'master@regionalaltaperformance.firebaseapp.com'",
        "meta": {
          ".validate": "newData.hasChildren(['code', 'passwordHash', 'active', 'createdAt', 'updatedAt']) && newData.child('code').val() == $sigla"
        },
        "kpis": {
          "$kpiId": {
            ".validate": "newData.hasChildren(['id', 'nome', 'cor', 'kind', 'checkIn', 'checkOut', 'ordem', 'ativo', 'createdAt', 'updatedAt']) && newData.child('id').val() == $kpiId && (newData.child('kind').val() == 'volume' || newData.child('kind').val() == 'conversao' || newData.child('kind').val() == 'alvo')",
            "subs": {
              "$subId": {
                ".validate": "newData.hasChildren(['id', 'nome', 'kind', 'checkIn', 'checkOut', 'ordem', 'ativo', 'createdAt', 'updatedAt']) && newData.child('id').val() == $subId && (newData.child('kind').val() == 'volume' || newData.child('kind').val() == 'conversao' || newData.child('kind').val() == 'alvo')"
              }
            }
          }
        },
        "metas": {
          "$month": {
            "$kpiId": {
              ".validate": "newData.hasChildren(['valor', 'updatedAt', 'updatedBy']) || newData.hasChild('subs')",
              "subs": {
                "$subId": {
                  ".validate": "newData.hasChildren(['valor', 'updatedAt', 'updatedBy'])"
                }
              }
            }
          }
        },
        "config": {
          "checkSchedule": {
            ".validate": "newData.hasChildren(['checkIn', 'checkOut', 'weekdays', 'timezone', 'updatedAt'])"
          }
        },
        "managerChecks": {
          "$month": {
            "entries": {
              ".write": "auth != null && (auth.token.email == 'master@regionalaltaperformance.firebaseapp.com' || auth.token.email == ('loja.' + $sigla.toLowerCase() + '@regionalaltaperformance.firebaseapp.com'))"
            }
          }
        },
        "results": {
          "$month": {
            ".write": "auth != null && (auth.token.email == 'master@regionalaltaperformance.firebaseapp.com' || auth.token.email == ('loja.' + $sigla.toLowerCase() + '@regionalaltaperformance.firebaseapp.com'))"
          }
        }
      }
    }
  }
}
